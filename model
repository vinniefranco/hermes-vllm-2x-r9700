#!/usr/bin/env bash
# Switch which model server is up. Both GPUs are committed to one server at a
# time, so an alternate model REPLACES the default `vllm` service (and takes
# its `vllm` network alias so Caddy / clients keep working).
#
#   ./model list              profiles you can switch to
#   ./model status            what's running now
#   ./model use default       back to the default vLLM service
#   ./model use <profile>     stop the current server, start that profile's
#
# A profile = a compose service with `profiles: ["<name>"]` and the `vllm`
# alias (see compose.yaml "Alternate models"). Stopped servers stay stopped
# across reboots (`restart: unless-stopped`), so whatever you picked last wins.
set -euo pipefail
cd "$(dirname "$0")"

DEFAULT_SVC=vllm

# profile -> service, from compose.yaml (one service per profile by convention)
profiles() {
  python3 - <<'PY'
import yaml
d = yaml.safe_load(open("compose.yaml"))
for name, svc in d["services"].items():
    for p in svc.get("profiles", []) or []:
        print(p, name)
PY
}

svc_for() {  # profile -> service name
  profiles | awk -v p="$1" '$1==p {print $2; exit}'
}

alt_services() { profiles | awk '{print $2}' | sort -u; }

running() { podman ps --format '{{.Names}}' 2>/dev/null; }

wait_healthy() {  # container
  local c=$1 i=0
  printf 'waiting for %s to become healthy' "$c"
  while :; do
    local st
    st=$(podman inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$c" 2>/dev/null || echo missing)
    case "$st" in
      healthy|running) echo " -> $st"; return 0 ;;
      exited|dead|missing) echo " -> $st"; echo "!! $c did not come up; see: podman logs $c" >&2; return 1 ;;
    esac
    i=$((i+1)); (( i % 6 == 0 )) && printf '.'
    sleep 5
  done
}

cmd_list() {
  echo "default   -> service $DEFAULT_SVC"
  profiles | awk '{printf "%-9s -> service %s\n", $1, $2}'
}

cmd_status() {
  local up; up=$(running)
  local any=0
  for s in $DEFAULT_SVC $(alt_services); do
    if grep -qx "$s" <<<"$up"; then
      echo "up:   $s ($(podman inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$s"))"; any=1
    else
      echo "down: $s"
    fi
  done
  (( any )) || echo "(no model server running)"
}

cmd_use() {
  local target=${1:-}; [[ -n $target ]] || { echo "usage: ./model use <default|profile>" >&2; exit 2; }
  local svc profile=""
  if [[ $target == default ]]; then svc=$DEFAULT_SVC
  else
    svc=$(svc_for "$target")
    [[ -n $svc ]] || { echo "unknown profile '$target'. Known:" >&2; cmd_list >&2; exit 2; }
    profile=$target
  fi

  # Stop whatever model server is up (other than the target).
  for s in $DEFAULT_SVC $(alt_services); do
    [[ $s == "$svc" ]] && continue
    if grep -qx "$s" <<<"$(running)"; then
      echo "stopping $s"; podman stop -t 60 "$s" >/dev/null
    fi
  done

  # Start the target through compose so a changed compose.yaml (new flags,
  # image) is picked up: compose recreates the container when its config hash
  # differs and just starts it otherwise.
  if grep -qx "$svc" <<<"$(running)"; then
    echo "$svc already running"
  else
    echo "starting $svc"
    if [[ -n $profile ]]; then podman-compose --profile "$profile" up -d --no-deps "$svc"
    else podman-compose up -d --no-deps "$svc"; fi
  fi
  wait_healthy "$svc"
  echo "now serving via alias vllm:8180 -> $svc"
}

case "${1:-}" in
  list) cmd_list ;;
  status) cmd_status ;;
  use) shift; cmd_use "$@" ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
