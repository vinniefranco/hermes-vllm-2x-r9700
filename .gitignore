# Local, generated, or secret state. Everything else is the setup and is committed.

# weights + HF cache (~28 GB); re-downloaded on first run
models/
# vllm-radiance JIT/compile caches; regenerated on first start
radiance-cache/
# benchmark results (the harness script is committed)
bench/results/
# agent workspace
projects/
# agent HOME on the workbench: synced skills + installed deps
workbench-home/
# Hermes state + secrets (seed: hermes-config.example.yaml)
hermes-data/
# Honcho Postgres data + DB password (seed: honcho-env.example)
honcho-data/
# Caddy's internal CA keys + issued certs; regenerated on first run
configs/caddy/data/
configs/caddy/config/
# per-install workbench secrets: SSH session env (Multica key), sshd host keys, authorized key
configs/workbench/environment
configs/workbench/ssh/

*.log
.DS_Store
scratch/
tmp/
