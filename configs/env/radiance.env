# Env for the vllm-radiance serving image (docker.io/stilldeadcode/vllm-radiance).
# Knob reference is the repo's DOCKERHUB.md:
# https://codeberg.org/StillDeadcode/vllm-radiance
HIP_VISIBLE_DEVICES=0,1

# AITER routing: unified attention only. The other AITER paths are unsupported
# or slower on RDNA4; radiance's own kernels cover them instead.
VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1
VLLM_ROCM_USE_AITER_MHA=0
VLLM_ROCM_USE_AITER_MLA=0
VLLM_ROCM_USE_AITER_MOE=0
VLLM_ROCM_USE_AITER_LINEAR=0
VLLM_ROCM_USE_AITER_FP8BMM=0
VLLM_ROCM_USE_AITER_FP4BMM=0
VLLM_ROCM_USE_AITER_RMSNORM=0
NCCL_PROTO=Simple

# Radiance kernel/feature switches. R4D = hand-written gfx1201 kernels
# (attention, all-reduce, skinny GEMM); the startup bwtest confirms GPU 0<->1
# P2P for the all-reduce. Dynamic draft varies MTP depth per request
# (lossless); fast draft packs drafter weights (pair with TAU=0.28 per
# upstream docs).
RADIANCE_USE_R4D=1
RADIANCE_PRESHUFFLE=1
RADIANCE_USE_R4D_AR=1
RADIANCE_USE_R4D_AR_QUANT=1
RADIANCE_FUSE_RMS_QUANT=1
RADIANCE_DYNAMIC_DRAFT=1
RADIANCE_FAST_DRAFT=1
RADIANCE_DRAFT_TAU=0.28

# Compile/kernel caches, all under the ./radiance-cache bind mount so warm
# restarts skip the JIT (cold start ~10 min, warm ~90 s).
VLLM_CACHE_ROOT=/cache/vllm
TORCHINDUCTOR_CACHE_DIR=/cache/inductor
TRITON_CACHE_DIR=/cache/triton
AITER_ROOT_DIR=/cache/aiter
TRITON_CACHE_AUTOTUNING=1
