# Env for the ParoQuant profile (vllm-paro): the env block of upstream's
# paroquant/run_paroquant.sh (build/radiance-vllm-mxfp4) at its MODE=prod values,
# minus the cache-dir keying (one fixed cache dir per profile here). Knob reference:
# build/radiance-vllm-mxfp4/PAROQUANT.md. Radiance/AITER switches that differ from
# radiance.env are upstream's measured PARO config, not drift.
ROCR_VISIBLE_DEVICES=0,1
HIP_VISIBLE_DEVICES=0,1
HF_HUB_OFFLINE=1

# What the prelude serves (dirs under ./models, produced by ./setup-paro).
PARO_MODEL_DIR=Swift-Qwen3.8-27B-PARO-MXFP6
PARO_DRAFTER_DIR=Qwen3.8-27B-DFlash2-FP8

# AITER routing (as radiance.env)
VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1
VLLM_ROCM_USE_AITER_MHA=0
VLLM_ROCM_USE_AITER_MLA=0
VLLM_ROCM_USE_AITER_MOE=0
VLLM_ROCM_USE_AITER_LINEAR=0
VLLM_ROCM_USE_AITER_FP8BMM=0
VLLM_ROCM_USE_AITER_FP4BMM=0
VLLM_ROCM_USE_AITER_RMSNORM=0
NCCL_PROTO=Simple

# R4D kernels + all-reduce
RADIANCE_USE_R4D=1
RADIANCE_USE_R4D_AR=1
RADIANCE_USE_R4D_AR_QUANT=1
RADIANCE_R4D_REPORT=1
RADIANCE_AR_MAX_KB=86016
RADIANCE_AR_QNB=96
RADIANCE_AR_QNT=1024
RADIANCE_AR_OVERLAP=0
RADIANCE_STEP_TRACE=0
RADIANCE_PRESHUFFLE=1
RADIANCE_FUSE_RMS_QUANT=1
R4D_ATTN_FP8=3
RADIANCE_SKINNY_GEMM=1
RADIANCE_TOPK_TRITON_MIN_ROWS=1
RADIANCE_KV_GROUP_OPT=1

# Gated delta net
RADIANCE_GDN_FUSED_UPDATE=1
RADIANCE_GDN_MERGE_INPROJ=0
RADIANCE_GDN_FUSED_MAX_ITEMS=32
RADIANCE_GDN_PATHS=both

# DFlash2 drafter (external; the PARO checkpoint ships no MTP head)
RADIANCE_DYNAMIC_WIDTH=1
RADIANCE_DYNW_ALPHA=0.35
RADIANCE_DYNW_MARGIN=2
RADIANCE_DYNW_MIN=2
RADIANCE_DYNW_MIN_BATCH=3
RADIANCE_DFLASH_SELECTOR_TOPK=
RADIANCE_FAST_DRAFT=1
RADIANCE_DRAFT_TAU=0.20
RADIANCE_DRAFT_RERANK=80
RADIANCE_VERIFY_HEAD=1
RADIANCE_VERIFY_HEAD_MAX_M=32

# MXFP4 kernel knobs. MXFP6 runs on the same loader and kernels (needs WPERM=1); inert for
# int4/int5. Upstream prod values.
RADIANCE_MXFP4_W4A8=1
RADIANCE_MXFP4_WPERM=1
RADIANCE_MXFP4_DECODE_NT=1
RADIANCE_MXFP4_DECODE_MAX_M=64
RADIANCE_MXFP4_EPIFAST=1
RADIANCE_MXFP4_TN4_MIN_M=2048
RADIANCE_MXFP4_A_TILED_MIN_M=513

# ParoQuant. I8/PG/ZPE are int5-only; 1 for an int5 checkpoint, 0 otherwise (the compile
# cache is keyed on them). CHECKALL empty = no numerics gate (prod).
RADIANCE_PAROQUANT=1
RADIANCE_PQ_I8=0
RADIANCE_PQ_PG=0
RADIANCE_PQ_ZPE=0
RADIANCE_PQ_PG_PRODUCER=3
RADIANCE_PQ_CHECKALL=
RADIANCE_PQM_CHECKALL=
RADIANCE_PQM_CHECK_MAX_M=128
RADIANCE_PQ_CHECK_MAX_M=128
RADIANCE_PQ_DECODE_MAX_M=64
RADIANCE_PQ_WPERM=1
RADIANCE_PQ_DECODE_NT=1
RADIANCE_PQ_ATILED=1
RADIANCE_PQ_AT_LBK=128
RADIANCE_PQ_AT_HOIST=1
RADIANCE_PQ_PTOK=1
RADIANCE_PQ_FUSED_TOKQ=1
RADIANCE_PQ_ROT_STREAM=1
RADIANCE_PQ_ROT_STREAM2=1
RADIANCE_PQ_ROT_STREAM3=0
RADIANCE_PQ_AR_CHECK=0
RADIANCE_PQ_AR_FALLBACK=0
RADIANCE_PQ_ROT_V2=1

# Compile/kernel caches under the ./radiance-cache/paro-mxfp6 mount. Compile caches validate
# on model + flags and must not be shared with the default service's ./radiance-cache.
VLLM_CACHE_ROOT=/cache/vllm
TORCHINDUCTOR_CACHE_DIR=/cache/inductor
TRITON_CACHE_DIR=/cache/triton
AITER_ROOT_DIR=/cache/aiter
TRITON_CACHE_AUTOTUNING=1
