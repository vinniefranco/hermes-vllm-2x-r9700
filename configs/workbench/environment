# Mounted at /etc/environment: PAM injects these into every SSH session, which
# is the only way compose-level env reaches the agent's shells (sshd starts
# sessions with a clean environment). Same egress policy as the rest of the
# stack: internet only via squid, which denies RFC1918/link-local/CGNAT.
HTTP_PROXY=http://squid:3128
HTTPS_PROXY=http://squid:3128
http_proxy=http://squid:3128
https_proxy=http://squid:3128
NO_PROXY=vllm,caddy,hermes,honcho,workbench,localhost,127.0.0.1,::1,.dns.podman
no_proxy=vllm,caddy,hermes,honcho,workbench,localhost,127.0.0.1,::1,.dns.podman
LANG=C.UTF-8
