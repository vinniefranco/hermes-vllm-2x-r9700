# TLS termination for the stack. The root to trust on clients is
# ./configs/caddy/data/caddy/pki/authorities/local/root.crt (see README).
# Reach this box by another name? Add it below, then:
#   podman exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	local_certs
}

# One hostname on 443, path-routed (UniFi allows only a single alias for this IP):
#   /v1/*     -> vLLM, which serves both the OpenAI and Anthropic API formats
#   /hermes/* -> Hermes gateway; it's OpenAI-compatible too, so it needs its
#                own prefix, stripped before proxying
#   the rest  -> Hermes dashboard, at root so its root-relative assets resolve
https://llm.home.vincentfranco.com, https://studio-lin, https://studio-lin.local, https://192.168.86.127, https://localhost {
	log {
		output stdout
		format console
	}
	@llmapi path /v1/*
	handle @llmapi {
		reverse_proxy vllm:8180
	}
	handle_path /hermes/* {
		reverse_proxy hermes:8642
	}
	handle {
		reverse_proxy hermes:9119
	}
}

# Hermes Desktop's Remote Gateway expects host:9119, so the backend gets its
# own TLS site on that port. The browser dashboard stays portless above.
https://llm.home.vincentfranco.com:9119, https://studio-lin:9119, https://studio-lin.local:9119, https://192.168.86.127:9119, https://localhost:9119 {
	reverse_proxy hermes:9119
}
